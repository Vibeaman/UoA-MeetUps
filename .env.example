# Public Supabase project configuration used by the browser client.
# Both variables are required — the app will throw at startup if either is
# missing or empty. Copy this file to .env and fill in your project's values
# from Supabase Dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key
